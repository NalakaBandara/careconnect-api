generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       BigInt                     @id @default(autoincrement())
  email                    String                     @unique @db.VarChar(255)
  firstName                String                     @db.VarChar(100)
  lastName                 String                     @db.VarChar(100)
  dateOfBirth              DateTime?                  @db.Date
  phone                    String?                    @db.VarChar(30)
  profilePhoto             String?                    @db.VarChar(500)
  nic                      String?                    @unique @db.VarChar(50)
  nicPhoto                 String?                    @db.VarChar(500)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  status                   String                     @default("ACTIVE") @db.VarChar(30)
  passwordHash             String?                    @db.VarChar(255)
  anonymisedAt             DateTime?
  patientAppointments      Appointment[]              @relation("PatientAppointments")
  appointmentStatusHistory AppointmentStatusHistory[] @relation("StatusChangedBy")
  auditLogs                AuditLog[]
  checkIns                 CheckIn[]                  @relation("CheckedInBy")
  clinicUsers              ClinicUser[]
  doctorProfile            DoctorProfile?
  notifications            Notification[]
  userRoles                UserRole[]
}

model Role {
  id          BigInt     @id @default(autoincrement())
  name        String     @unique @db.VarChar(50)
  description String?    @db.VarChar(255)
  createdAt   DateTime   @default(now())
  userRoles   UserRole[]
}

model UserRole {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  roleId    BigInt
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
}

model Clinic {
  id              BigInt                @id @default(autoincrement())
  name            String                @db.VarChar(200)
  description     String?
  addressLine1    String                @db.VarChar(255)
  addressLine2    String?               @db.VarChar(255)
  city            String                @db.VarChar(100)
  district        String?               @db.VarChar(100)
  province        String?               @db.VarChar(100)
  postalCode      String?               @db.VarChar(20)
  country         String                @default("Sri Lanka") @db.VarChar(100)
  telephone       String?               @db.VarChar(30)
  email           String?               @db.VarChar(255)
  latitude        String?               @db.VarChar(20)
  longitude       String?               @db.VarChar(20)
  status          String                @default("ACTIVE") @db.VarChar(30)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  appointments    Appointment[]
  operatingHours  ClinicOperatingHour[]
  clinicUsers     ClinicUser[]
  clinicServices  ClinicService[]
  doctorClinics   DoctorClinic[]
  doctorSchedules DoctorSchedule[]
}

model ClinicUser {
  id        BigInt   @id @default(autoincrement())
  clinicId  BigInt
  userId    BigInt
  createdAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([clinicId, userId])
}

model ClinicOperatingHour {
  id          BigInt    @id @default(autoincrement())
  clinicId    BigInt
  dayOfWeek   Int
  openingTime DateTime? @db.Time(6)
  closingTime DateTime? @db.Time(6)
  isClosed    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  clinic      Clinic    @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, dayOfWeek])
}

model DoctorProfile {
  id                BigInt            @id @default(autoincrement())
  userId            BigInt            @unique
  licenseNumber     String?           @unique @db.VarChar(100)
  bio               String?
  yearsOfExperience Int?
  isVerified        Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  appointments      Appointment[]
  doctorClinics     DoctorClinic[]
  user              User              @relation(fields: [userId], references: [id])
  doctorSchedules   DoctorSchedule[]
  doctorServices    DoctorService[]
  doctorSpecialties DoctorSpecialty[]
}

model DoctorClinic {
  id              BigInt        @id @default(autoincrement())
  doctorProfileId BigInt
  clinicId        BigInt
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  clinic          Clinic        @relation(fields: [clinicId], references: [id])
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id])

  @@unique([doctorProfileId, clinicId])
}

model Specialty {
  id                BigInt            @id @default(autoincrement())
  name              String            @unique @db.VarChar(150)
  description       String?
  createdAt         DateTime          @default(now())
  doctorSpecialties DoctorSpecialty[]
}

model DoctorSpecialty {
  id              BigInt        @id @default(autoincrement())
  doctorProfileId BigInt
  specialtyId     BigInt
  createdAt       DateTime      @default(now())
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id])
  specialty       Specialty     @relation(fields: [specialtyId], references: [id])

  @@unique([doctorProfileId, specialtyId])
}

model Service {
  id              BigInt          @id @default(autoincrement())
  name            String          @unique @db.VarChar(150)
  description     String?
  durationMinutes Int?
  status          String          @default("ACTIVE") @db.VarChar(30)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  appointments    Appointment[]
  clinicServices  ClinicService[]
  doctorServices  DoctorService[]
}

model ClinicService {
  id        BigInt   @id @default(autoincrement())
  clinicId  BigInt
  serviceId BigInt
  createdAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  service   Service  @relation(fields: [serviceId], references: [id])

  @@unique([clinicId, serviceId])
}

model DoctorService {
  id              BigInt        @id @default(autoincrement())
  doctorProfileId BigInt
  serviceId       BigInt
  createdAt       DateTime      @default(now())
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id])
  service         Service       @relation(fields: [serviceId], references: [id])

  @@unique([doctorProfileId, serviceId])
}

model DoctorSchedule {
  id                  BigInt        @id @default(autoincrement())
  doctorProfileId     BigInt
  clinicId            BigInt
  dayOfWeek           Int
  startTime           DateTime      @db.Time(6)
  endTime             DateTime      @db.Time(6)
  slotDurationMinutes Int
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  appointments        Appointment[]
  clinic              Clinic        @relation(fields: [clinicId], references: [id])
  doctorProfile       DoctorProfile @relation(fields: [doctorProfileId], references: [id])
}

model Appointment {
  id               BigInt                     @id @default(autoincrement())
  patientId        BigInt
  doctorProfileId  BigInt
  clinicId         BigInt
  serviceId        BigInt
  doctorScheduleId BigInt
  appointmentDate  DateTime                   @db.Date
  startTime        DateTime                   @db.Time(6)
  endTime          DateTime                   @db.Time(6)
  status           String                     @default("PENDING") @db.VarChar(30)
  reason           String?
  notes            String?
  bookingReference String?                    @unique @db.VarChar(20)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  clinic           Clinic                     @relation(fields: [clinicId], references: [id])
  doctorProfile    DoctorProfile              @relation(fields: [doctorProfileId], references: [id])
  doctorSchedule   DoctorSchedule             @relation(fields: [doctorScheduleId], references: [id])
  patient          User                       @relation("PatientAppointments", fields: [patientId], references: [id])
  service          Service                    @relation(fields: [serviceId], references: [id])
  statusHistory    AppointmentStatusHistory[]
  checkIn          CheckIn?
}

model AppointmentStatusHistory {
  id              BigInt      @id @default(autoincrement())
  appointmentId   BigInt
  status          String      @db.VarChar(30)
  reason          String?
  changedByUserId BigInt
  createdAt       DateTime    @default(now())
  appointment     Appointment @relation(fields: [appointmentId], references: [id])
  changedBy       User        @relation("StatusChangedBy", fields: [changedByUserId], references: [id])
}

model CheckIn {
  id                BigInt      @id @default(autoincrement())
  appointmentId     BigInt      @unique
  checkedInAt       DateTime    @default(now())
  checkedInByUserId BigInt
  method            String      @db.VarChar(30)
  queueNumber       Int?
  appointment       Appointment @relation(fields: [appointmentId], references: [id])
  checkedInBy       User        @relation("CheckedInBy", fields: [checkedInByUserId], references: [id])
}

model Notification {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt
  type      String    @db.VarChar(30)
  title     String    @db.VarChar(200)
  message   String
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt?
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   BigInt?
  ipAddress  String?  @db.Inet
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
}

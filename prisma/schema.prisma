generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// 1. USERS
// ============================================================

model User {
  id           BigInt    @id @default(autoincrement())
  email        String    @unique @db.VarChar(255)
  passwordHash String    @db.VarChar(255)
  firstName    String    @db.VarChar(100)
  lastName     String    @db.VarChar(100)
  dateOfBirth  DateTime? @db.Date
  phone        String?   @db.VarChar(30)
  profilePhoto String?   @db.VarChar(500)
  nic          String?   @unique @db.VarChar(50)
  nicPhoto     String?   @db.VarChar(500)
  status       String    @default("ACTIVE") @db.VarChar(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles UserRole[]

  doctorProfile DoctorProfile?
  clinicUsers   ClinicUser[]

  patientAppointments Appointment[] @relation("PatientAppointments")

  appointmentStatusHistory AppointmentStatusHistory[] @relation("StatusChangedBy")

  checkIns CheckIn[] @relation("CheckedInBy")

  notifications Notification[]

  refreshTokens RefreshToken[]

  auditLogs AuditLog[]
}

// ============================================================
// 2. ROLES
// ============================================================

model Role {
  id          BigInt  @id @default(autoincrement())
  name        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)

  createdAt DateTime @default(now())

  userRoles UserRole[]
}

// ============================================================
// 3. USER ROLES
// ============================================================

model UserRole {
  id        BigInt @id @default(autoincrement())
  userId    BigInt
  roleId    BigInt

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

// ============================================================
// 4. CLINICS
// ============================================================

model Clinic {
  id          BigInt  @id @default(autoincrement())
  name        String  @db.VarChar(200)
  description String?

  addressLine1 String  @db.VarChar(255)
  addressLine2 String? @db.VarChar(255)
  city         String  @db.VarChar(100)
  district     String? @db.VarChar(100)
  province     String? @db.VarChar(100)
  postalCode   String? @db.VarChar(20)
  country      String  @default("Sri Lanka") @db.VarChar(100)

  telephone String? @db.VarChar(30)
  email     String? @db.VarChar(255)
  status    String  @default("ACTIVE") @db.VarChar(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinicUsers     ClinicUser[]
  operatingHours  ClinicOperatingHour[]
  doctorClinics   DoctorClinic[]
  doctorSchedules DoctorSchedule[]
  appointments    Appointment[]
}

// ============================================================
// 5. CLINIC USERS
// ============================================================

model ClinicUser {
  id       BigInt @id @default(autoincrement())
  clinicId BigInt
  userId   BigInt

  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([clinicId, userId])
}

// ============================================================
// 6. CLINIC OPERATING HOURS
// ============================================================

model ClinicOperatingHour {
  id       BigInt @id @default(autoincrement())
  clinicId BigInt

  dayOfWeek   Int
  openingTime DateTime? @db.Time
  closingTime DateTime? @db.Time
  isClosed    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, dayOfWeek])
}

// ============================================================
// 7. DOCTOR PROFILES
// ============================================================

model DoctorProfile {
  id     BigInt @id @default(autoincrement())
  userId BigInt @unique

  licenseNumber     String? @unique @db.VarChar(100)
  bio               String?
  yearsOfExperience Int?
  isVerified        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  doctorClinics     DoctorClinic[]
  doctorSpecialties DoctorSpecialty[]
  doctorServices    DoctorService[]
  doctorSchedules   DoctorSchedule[]
  appointments      Appointment[]
}

// ============================================================
// 8. DOCTOR CLINICS
// ============================================================

model DoctorClinic {
  id              BigInt @id @default(autoincrement())
  doctorProfileId BigInt
  clinicId        BigInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id])
  clinic        Clinic        @relation(fields: [clinicId], references: [id])

  @@unique([doctorProfileId, clinicId])
}

// ============================================================
// 9. SPECIALTIES
// ============================================================

model Specialty {
  id          BigInt  @id @default(autoincrement())
  name        String  @unique @db.VarChar(150)
  description String?

  createdAt DateTime @default(now())

  doctorSpecialties DoctorSpecialty[]
}

// ============================================================
// 10. DOCTOR SPECIALTIES
// ============================================================

model DoctorSpecialty {
  id              BigInt @id @default(autoincrement())
  doctorProfileId BigInt
  specialtyId     BigInt

  createdAt DateTime @default(now())

  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id])
  specialty     Specialty     @relation(fields: [specialtyId], references: [id])

  @@unique([doctorProfileId, specialtyId])
}

// ============================================================
// 11. SERVICES
// ============================================================

model Service {
  id              BigInt  @id @default(autoincrement())
  name            String  @unique @db.VarChar(150)
  description     String?
  durationMinutes Int?
  status          String  @default("ACTIVE") @db.VarChar(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorServices DoctorService[]
  appointments   Appointment[]
}

// ============================================================
// 12. DOCTOR SERVICES
// ============================================================

model DoctorService {
  id              BigInt @id @default(autoincrement())
  doctorProfileId BigInt
  serviceId       BigInt

  createdAt DateTime @default(now())

  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id])
  service       Service       @relation(fields: [serviceId], references: [id])

  @@unique([doctorProfileId, serviceId])
}

// ============================================================
// 13. DOCTOR SCHEDULES
// ============================================================

model DoctorSchedule {
  id              BigInt @id @default(autoincrement())
  doctorProfileId BigInt
  clinicId        BigInt

  dayOfWeek           Int
  startTime           DateTime @db.Time
  endTime             DateTime @db.Time
  slotDurationMinutes Int
  isActive            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id])
  clinic        Clinic        @relation(fields: [clinicId], references: [id])

  appointments Appointment[]
}

// ============================================================
// 14. APPOINTMENTS
// ============================================================

model Appointment {
  id BigInt @id @default(autoincrement())

  patientId        BigInt
  doctorProfileId  BigInt
  clinicId         BigInt
  serviceId        BigInt
  doctorScheduleId BigInt

  appointmentDate DateTime @db.Date
  startTime       DateTime @db.Time
  endTime         DateTime @db.Time

  status String @default("PENDING") @db.VarChar(30)
  reason String?
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient        User           @relation("PatientAppointments", fields: [patientId], references: [id])
  doctorProfile  DoctorProfile  @relation(fields: [doctorProfileId], references: [id])
  clinic         Clinic         @relation(fields: [clinicId], references: [id])
  service        Service        @relation(fields: [serviceId], references: [id])
  doctorSchedule DoctorSchedule @relation(fields: [doctorScheduleId], references: [id])

  statusHistory AppointmentStatusHistory[]
  checkIn       CheckIn?
}

// ============================================================
// 15. APPOINTMENT STATUS HISTORY
// ============================================================

model AppointmentStatusHistory {
  id            BigInt @id @default(autoincrement())
  appointmentId BigInt

  status String @db.VarChar(30)
  reason String?

  changedByUserId BigInt

  createdAt DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  changedBy User @relation("StatusChangedBy", fields: [changedByUserId], references: [id])
}

// ============================================================
// 16. CHECK-INS
// ============================================================

model CheckIn {
  id            BigInt @id @default(autoincrement())
  appointmentId BigInt @unique

  checkedInAt       DateTime @default(now())
  checkedInByUserId BigInt
  method            String  @db.VarChar(30)
  queueNumber       Int?

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  checkedInBy User @relation("CheckedInBy", fields: [checkedInByUserId], references: [id])
}

// ============================================================
// 17. NOTIFICATIONS
// ============================================================

model Notification {
  id     BigInt @id @default(autoincrement())
  userId BigInt

  type    String @db.VarChar(30)
  title   String @db.VarChar(200)
  message String

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ============================================================
// 18. REFRESH TOKENS
// ============================================================

model RefreshToken {
  id     BigInt @id @default(autoincrement())
  userId BigInt

  tokenHash String @unique @db.VarChar(255)

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ============================================================
// 19. AUDIT LOGS
// ============================================================

model AuditLog {
  id     BigInt @id @default(autoincrement())
  userId BigInt?

  action     String  @db.VarChar(100)
  entityType String  @db.VarChar(100)
  entityId   BigInt?

  ipAddress String? @db.Inet
  userAgent String?
  metadata  Json?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}
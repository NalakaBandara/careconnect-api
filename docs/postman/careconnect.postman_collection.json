{
  "info": {
    "name": "CareConnect API - Local",
    "_postman_id": "careconnect-api-local",
    "description": "Postman collection for CareConnect API (local development). Replace {{baseUrl}} and tokens in environment before use.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        },
        {
          "name": "GET /health/db",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health/db", "host": ["{{baseUrl}}"], "path": ["health","db"] }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/v1/auth/register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const token = pm.response.json().accessToken;",
                  "  if (token) { pm.environment.set('authToken', token); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.{{$timestamp}}@example.com\",\n  \"password\": \"Password123!\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"dateOfBirth\": \"1990-05-15\",\n  \"phone\": \"+15555550111\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","register"] }
          },
          "description": "Public. Creates a PATIENT account and returns { data, accessToken }. Saves the token to {{authToken}}; email is timestamped so this can be re-run."
        },
        {
          "name": "POST /api/v1/auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const token = pm.response.json().accessToken;",
                  "  if (token) { pm.environment.set('authToken', token); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] }
          },
          "description": "Public. Returns { data, accessToken } (valid 1 hour, no refresh token) and saves the token to {{authToken}}. Run this first, then any other request."
        },
        {
          "name": "GET /api/protected",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "x-dev-user-sub", "value": "{{devUserSub}}" },
              { "key": "x-dev-user-email", "value": "{{devUserEmail}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/protected", "host": ["{{baseUrl}}"], "path": ["api","protected"] }
          },
          "description": "Authenticated user info; requires the Bearer token from Register/Login (or the dev headers when AUTH_ENABLED=false)."
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "GET /api/v1/users/me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "x-dev-user-sub", "value": "{{devUserSub}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/users/me", "host": ["{{baseUrl}}"], "path": ["api","v1","users","me"] }
          }
        },
        {
          "name": "POST /api/v1/users/me (create profile)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "x-dev-user-sub", "value": "{{devUserSub}}" },
              { "key": "x-dev-user-email", "value": "{{devUserEmail}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"phone\": \"+1234567890\",\n  \"address\": \"100 Dev Lane\",\n  \"dateOfBirth\": \"1990-01-01\",\n  \"gender\": \"other\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/users/me", "host": ["{{baseUrl}}"], "path": ["api","v1","users","me"] }
          },
          "description": "Create profile for authenticated human user. If `AUTH_ENABLED=false`, uses `x-dev-user-sub` to map to DB insertion."
        },
        {
          "name": "PUT /api/v1/users/me (update)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "x-dev-user-sub", "value": "{{devUserSub}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Updated\",\n  \"phone\": \"+1987654321\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/users/me", "host": ["{{baseUrl}}"], "path": ["api","v1","users","me"] }
          }
        },
        {
          "name": "GET /api/v1/users/:id (admin)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{authToken}}" } ],
            "url": { "raw": "{{baseUrl}}/api/v1/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","users","{{userId}}"], "variable": [ { "key": "userId", "value": "" } ] }
          },
          "description": "Requires `ADMIN` role assigned in DB or test user."
        }
      ]
    },
    {
